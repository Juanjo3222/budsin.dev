# Copiado a /etc/budsin-hosting.env por install.sh (modo 0640, root:budsin-hosting).
# Secretos y datos de PayPal: se rellenan con `budsin-hosting-set CLAVE` (el Secret se pide sin mostrarse).
PORT=3102
BASE_DOMAIN=budsin.dev
DATA_DIR=/var/lib/budsin-hosting
SITES_DIR=/var/www/hosting/sites
ACTIVE_DIR=/var/www/hosting/active
FIREBASE_API_KEY=AIzaSyCBN77CtgH-J5NYWhVyW6p1jldXdxbok-U
ADMIN_EMAILS=juvaldiviam@gmail.com,juanjoseguravegamail@gmail.com
ALLOWED_ORIGINS=https://budsin.dev
MAX_UPLOAD_MB=95
TOTAL_CAP_GB=40
# PayPal (Sandbox hasta pasar a producción: PAYPAL_API_BASE=https://api-m.paypal.com)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_PLUS=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_ULTRA=
# Dominios propios (Cloudflare for SaaS). CF_API_TOKEN con permiso "SSL and Certificates: Edit" sobre la zona budsin.dev.
#   budsin-hosting-set CF_API_TOKEN   (silencioso)    budsin-hosting-set CF_ZONE_ID
CF_API_TOKEN=
CF_ZONE_ID=
CUSTOM_CNAME_TARGET=custom.budsin.dev
DOMAINS_DIR=/var/www/hosting/domains
ACTIVE_DOMAINS_DIR=/var/www/hosting/active-domains
# Tope global de dominios propios (evita pasar de los 100 hostnames gratuitos de Cloudflare)
MAX_DOMAINS=100
